{
  "name": "carbonite",
  "version": "1.0.0",
  "description": "An academic-integrity toolkit for teachers: author an assignment, attach a separate AI-directed instruction as an invisible Unicode canary, and verify submissions.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "bin": { "carbonite": "./bin/carbonite.js" },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./core/*": "./src/core/*.js"
  },
  "files": ["src", "bin", "web", "docs", "README.md"],
  "scripts": {
    "test": "node --test",
    "build:web": "node tools/build-web.js",
    "doctor": "node bin/carbonite.js doctor"
  },
  "keywords": ["academic-integrity", "unicode", "steganography", "canary", "education", "ai-detection"],
  "dependencies": {}
}
